blueprint:
  name: Aqara H2 Dimmer Switch (KD-R01D) - MQTT Native CCT Control
  description: >
    Control an external CCT light using the raw MQTT payloads from an Aqara H2 Dimmer (KD-R01D) via Zigbee2MQTT.
    Ensures instantaneous response and bypasses disabled HA entities.
  domain: automation
  input:
    mqtt_topic:
      name: MQTT Topic
      description: The absolute MQTT topic your H2 publishes to (e.g., z2m/Küche Lichtschalter Aqara Dimmer).
      selector:
        text:
    target_light:
      name: Target Light
      description: The CCT Light entity you want to control.
      selector:
        entity:
          filter:
            - domain: light
          multiple: false
    brightness_step_scale:
      name: Brightness Sensitivity
      description: Multiplier for brightness changes. Higher values change brightness faster.
      default: 1.5
      selector:
        number:
          min: 0.5
          max: 5.0
          step: 0.1
    colortemp_step_scale:
      name: Color Temperature Sensitivity
      description: Kelvin adjustment scale factor when rotating while pressed.
      default: 60
      selector:
        number:
          min: 10
          max: 200
          step: 10
    colortemp_default:
      name: Default Color Temperature
      description: Target Kelvin applied on a double-click event.
      default: 5400
      selector:
        number:
          min: 2000
          max: 9000
          unit_of_measurement: "K"

variables:
  target_light_entity: !input target_light
  b_scale: !input brightness_step_scale
  ct_scale: !input colortemp_step_scale

trigger:
  - platform: mqtt
    topic: !input mqtt_topic

condition:
  - condition: template
    value_template: "{{ trigger.payload_json.action is defined and trigger.payload_json.action != null }}"

action:
  - choose:
      # 1. Single Click -> Toggle Light
      - conditions:
          - condition: template
            value_template: "{{ trigger.payload_json.action == 'single' }}"
        sequence:
          - service: light.toggle
            target:
              entity_id: "{{ target_light_entity }}"

      # 2. Double Click -> Reset to Default Kelvin
      - conditions:
          - condition: template
            value_template: "{{ trigger.payload_json.action == 'double' }}"
        sequence:
          - service: light.turn_on
            data:
              kelvin: !input colortemp_default
            target:
              entity_id: "{{ target_light_entity }}"

      # 3. Active Rotation
      - conditions:
          - condition: template
            value_template: "{{ trigger.payload_json.action == 'rotation' }}"
        sequence:
          - choose:
              # Case A: Knob rotated normally (Released state) -> Adjust Brightness
              - conditions:
                  - condition: template
                    value_template: "{{ trigger.payload_json.action_rotation_button_state == 'released' }}"
                sequence:
                  - service: light.turn_on
                    data:
                      brightness_pct: >-
                        {% set speed = trigger.payload_json.action_rotation_percent_speed | float(0) %}
                        {% if states(target_light_entity) == 'off' %}
                          {% if speed > 0 %} 5 {% else %} 0 {% endif %}
                        {% else %}
                          {% set current_pct = state_attr(target_light_entity, 'brightness') | float(0) / 2.55 %}
                          {% set step = (speed / 3.33) * (b_scale | float) %}
                          {{ min(100, max(1, (current_pct + step) | int)) }}
                        {% endif %}
                    target:
                      entity_id: "{{ target_light_entity }}"

              # Case B: Knob rotated while held down (Pressed state) -> Adjust Color Temperature
              - conditions:
                  - condition: template
                    value_template: "{{ trigger.payload_json.action_rotation_button_state == 'pressed' }}"
                sequence:
                  - service: light.turn_on
                    data:
                      kelvin: >-
                        {% set speed = trigger.payload_json.action_rotation_percent_speed | float(0) %}
                        {% set current_k = state_attr(target_light_entity, 'color_temp_kelvin') | float(4000) %}
                        {% set min_k = state_attr(target_light_entity, 'min_color_temp_kelvin') | float(2700) %}
                        {% set max_k = state_attr(target_light_entity, 'max_color_temp_kelvin') | float(6500) %}
                        {% set step = (speed / 3.33) * (ct_scale | float) %}
                        {{ min(max_k, max(min_k, (current_k + step) | int)) }}
                    target:
                      entity_id: "{{ target_light_entity }}"

mode: queued
max: 10
